root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Sample I/O committed under problems/**/tests/ must be preserved byte-for-byte
# (exact judge input/output), so don't let editors touch trailing whitespace
# or final newlines here.
[problems/**/tests/*.{in,out}]
insert_final_newline = false
trim_trailing_whitespace = false
